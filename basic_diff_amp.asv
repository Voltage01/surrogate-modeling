%% Clear everything
close all;
clear all;
clc;

%% Graphical Parameters:
FS=14;
FN='Times';
FW='normal';
FA='normal';

GRAY = [0.2,0.2,0.2];
GRAY_L = [0.6,0.6,0.6];

%% Defining parameters and Monte Carlo
N_MC = 600;

V_VS = 5;
R_C1 = 4.7e03;
R_C2 = 4.7e03;
I_S = 1e-03;
V_Vin_1_phase = 0;
V_Vin_2_phase = 180;

delta = 0.1;

    tic

    X_MC = (2*lhsdesign(N_MC,2)-1)*delta;

    figure, hold on
    histogram(R_C1*(1+X_MC(:,1)));
    histogram(R_C2*(1+X_MC(:,2)));
    index_NAN = zeros(N_MC,1);

    nstep = 20;
    tmp_time = [];

    %Monte Carlo Simulation
    for p1=1:N_MC
        PR_C1 = R_C1*(1+X_MC(p1,1));
        PR_C2 = R_C2*(1+X_MC(p1,2));
        PV_VS = V_VS;
        PI_S = I_S;

        filename = 'DIFFERENTIAL_PARAMS';

        fid2 = fopen([filename,'.cir'],'w');

        fprintf(fid2, '* Parameters the MC simulation of the Basic Differential Amplifier netlist \n\n');
        fprintf(fid2, ['.PARAM PR_C1=' num2str(PR_C1) '\n']);
        fprintf(fid2, ['.PARAM PR_C2=' num2str(PR_C2) '\n']);
        fprintf(fid2, ['.PARAM PV_VS=' num2str(PV_VS) '\n']);
        fprintf(fid2, ['.PARAM PI_S=' num2str(PI_S) '\n']);

        fclose(fid2);
        
        ans_sys = system(['/Applications/LTspice.app/Contents/MacOS/LTspice -b basic-differential-amplifier.cir'])

        if ans_sys==0
        
            sim_res=LTspice2Matlab('basic-differential-amplifier.raw');
            v2_raw=sim_res.variable_mat(1,:);
            v3_raw=sim_res.variable_mat(2,:);
            f_raw=sim_res.freq_vect;


            v2_raw(isnan(v2_raw)) = 0;
            v3_raw(isnan(v3_raw)) = 0;
            

        else
            index_NAN(p1) = 1;             
        end


    end

    %%
    MC_training = toc

    tmp = find(index_NAN==1);

    X_MC(tmp,:) = [];
    V_out(tmp,:) = [];
    v_out_time(tmp,:) = [];

    I_in(tmp,:) = [];
    i_in_time(tmp,:) = [];




    N_MC = size(V_out,1);

    filename = ['diff_data_',num2str(N_MC),'_v0.mat'];
    save(filename,'V_out','I_in','freq','v_out_time','i_in_time','time','X_MC','N_MC');



    figure(100)
    semilogx(freq,20*log10(abs(I_in(:,:))))


    figure(101)
    plot(time,i_in_time(:,:))
